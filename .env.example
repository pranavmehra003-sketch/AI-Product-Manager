# AI Product Manager — Environment Variables
# Copy this file to .env and fill in your values

# ─── LLM Provider — Choose ONE (Gemini preferred) ─────────────────────────

# Option A: Google Gemini (RECOMMENDED — cheaper, faster for structured output)
# Get your API key from: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_gemini_api_key_here
# Or use the alias:
# GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini model — gemini-2.0-flash (default), gemini-2.0-pro, gemini-1.5-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-2.0-flash

# Option B: OpenAI (Fallback if Gemini not configured)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
# Optional: OpenAI model (default: gpt-4o-mini for cost efficiency)
OPENAI_MODEL=gpt-4o-mini

# Force a specific provider (optional): "gemini" | "openai"
# If unset, auto-selects based on which key is present (Gemini first)
# LLM_PROVIDER=gemini

# ─── Database Paths ────────────────────────────────────────────────────────
# Optional: Database path (default: ./data/product_manager.db)
DB_PATH=./data/product_manager.db

# Optional: ChromaDB path (default: ./data/chroma_db)
CHROMA_PATH=./data/chroma_db
